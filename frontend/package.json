{
    "name": "radarsmith-frontend",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build",
        "preview": "vite preview",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "generate-types": "openapi-typescript ../backend/openapi.json -o src/api/schema.d.ts"
    },
    "dependencies": {
        "openapi-fetch": "^0.17.0",
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "react-router-dom": "^7.18.1"
    },
    "devDependencies": {
        "@eslint/js": "^9.17.0",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.1.0",
        "@types/react": "^19.1.0",
        "@types/react-dom": "^19.1.0",
        "@vitejs/plugin-react": "^4.3.4",
        "eslint": "^9.17.0",
        "eslint-plugin-react-hooks": "^5.1.0",
        "eslint-plugin-react-refresh": "^0.4.16",
        "fast-check": "^3.23.1",
        "globals": "^15.14.0",
        "jsdom": "^25.0.1",
        "openapi-typescript": "^7.13.0",
        "typescript": "^5.7.2",
        "typescript-eslint": "^8.19.0",
        "vite": "^6.0.7",
        "vitest": "^3.0.0"
    }
}
