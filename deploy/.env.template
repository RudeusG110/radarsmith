# Production stack credentials and settings for docker-compose.yml.
# `make prod-up` creates deploy/.env from this template automatically (see init-env.sh),
# filling in a random POSTGRES_PASSWORD, only when deploy/.env doesn't already exist.
# To use your own values instead, copy this file to deploy/.env and edit it by hand first.
# Keep deploy/.env OUT of git. These are NOT the dev/db.env.template values.

POSTGRES_USER=radarsmith
POSTGRES_PASSWORD=
POSTGRES_DB=radarsmith

# Must match the POSTGRES_* values above and use "db" (the compose service name) as the host.
rs_api_db_url=postgresql+psycopg://radarsmith:@db:5432/radarsmith

# Optional logging overrides (defaults: DEBUG, STREAM).
# rs_log_level=INFO
# rs_log_type=JSON
