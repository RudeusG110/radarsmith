# Logging settings. Copy to log_settings.env (next to settings.env) and adjust, or set the
# same variables in the environment. Variables use the rs_log_ prefix
# (see app/log/log_types.py); anything unset keeps its default.

rs_log_level="DEBUG"
rs_log_format="%(asctime)s (%(name)s) [%(levelname)s] %(message)s"
# STREAM for human-readable lines, JSON for one JSON object per line.
rs_log_type=STREAM
rs_log_application="radarsmith"
